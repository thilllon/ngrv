{
  "name": "ngrv",
  "version": "5.0.0",
  "description": "Capture build metadata and load it into OpenTelemetry Node.js resources",
  "type": "commonjs",
  "sideEffects": [
    "./dist/cli.cjs",
    "./dist/cli.mjs"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@12.4.2",
  "author": "thilllon <thilllon970@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thilllon/ngrv.git"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./otel": {
      "import": {
        "types": "./dist/otel.d.mts",
        "default": "./dist/otel.mjs"
      },
      "require": {
        "types": "./dist/otel.d.cts",
        "default": "./dist/otel.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "ngrv": "dist/cli.cjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "dev": "tsx src/index.ts",
    "lint": "biome lint .",
    "format": "biome format --write . && prettier --write \"**/*.{md,mdx,yaml,yml}\"",
    "format:check": "biome format . && prettier --check \"**/*.{md,mdx,yaml,yml}\"",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck",
    "test": "vitest run",
    "test:packaging": "vitest run --config vitest.packaging.config.mts && tsx scripts/package-smoke.mts",
    "test:example": "pnpm build && pnpm --dir example test",
    "changeset": "changeset",
    "release:publish": "changeset publish"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=12 <13"
  },
  "dependencies": {
    "commander": "^9.4.1"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@biomejs/biome": "2.5.14",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@commitlint/types": "^21.2.0",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@types/node": "24.13.5",
    "prettier": "3.9.8",
    "publint": "0.3.24",
    "tsdown": "0.23.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
